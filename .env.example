# --- LLM endpoints -----------------------------------------------------------
# Every model is reached through an OpenAI-compatible /chat/completions API.
# Each configs/models/*.yaml names the env var that holds its API key.

# Local Ollama (qwen2.5-coder:7b, ...). Ollama ignores the key but
# the OpenAI client requires a non-empty string.
OLLAMA_API_KEY=ollama

# Cloud provider for gpt-luna-6 (or any other OpenAI-compatible provider).
FAVOR_CLOUD_API_KEY=sk-...

# --- Defects4J ---------------------------------------------------------------
# bash scripts/setup.sh installs Defects4J 3.0.1 into benchmarks/defects4j and
# the harness finds it there by itself. Set D4J_HOME only for a checkout that
# lives somewhere else.
# D4J_HOME=/path/to/defects4j

# Java 11 is required by Defects4J 3.x; auto-detected from Homebrew or
# /usr/lib/jvm. Set JAVA_HOME only when detection fails.
# JAVA_HOME=/opt/homebrew/opt/openjdk@11/libexec/openjdk.jdk/Contents/Home
